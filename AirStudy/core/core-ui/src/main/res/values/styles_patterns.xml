<?xml version="1.0" encoding="utf-8"?>
<resources>





    <!-- 快捷入口胶囊（报告 §六.1「快捷入口」、§六.4 次按钮：品牌浅底 + 品牌字） -->
    <style name="Widget.Pf.QuickEntry">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">40dp</item>
        <item name="android:layout_marginEnd">@dimen/space_s</item>
        <item name="android:background">@drawable/bg_button_secondary</item>
        <item name="android:gravity">center</item>
        <item name="android:paddingStart">@dimen/space_l</item>
        <item name="android:paddingEnd">@dimen/space_l</item>
        <item name="android:textAppearance">@style/TextAppearance.Pf.BodyM</item>
        <item name="android:textColor">@color/accent_text</item>
        <item name="android:textStyle">bold</item>
        <item name="android:minWidth">@dimen/touch_target_min</item>
    </style>

    <!-- 最重要的那个入口用实心渐变（报告：品牌色只出现在主按钮 / 选中态 / 关键字） -->
    <style name="Widget.Pf.QuickEntry.Primary">
        <item name="android:background">@drawable/bg_button_primary</item>
        <item name="android:textColor">@color/text_on_accent</item>
    </style>

    <!-- 等分的次要操作按钮（一行两个） -->
    <style name="Widget.Pf.SecondaryAction">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">44dp</item>
        <item name="android:layout_weight">1</item>
        <item name="android:background">@drawable/bg_button_secondary</item>
        <item name="android:stateListAnimator">@null</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textAppearance">@style/TextAppearance.Pf.Button</item>
        <item name="android:textColor">@color/accent_text</item>
    </style>

    <!-- 分段选择（报告 §六.3：胶囊滑块式，激活项实心品牌色）；选中态走 View.isSelected -->
    <style name="Widget.Pf.SegmentChip">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">40dp</item>
        <item name="android:layout_weight">1</item>
        <item name="android:background">@drawable/bg_segment_chip</item>
        <item name="android:stateListAnimator">@null</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textAppearance">@style/TextAppearance.Pf.BodyM</item>
        <item name="android:textColor">@color/pf_segment_text</item>
        <item name="android:textStyle">bold</item>
    </style>
</resources>
