<?xml version="1.0" encoding="utf-8"?>

<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/pf_scene_card_root" android:layout_width="270dp" android:layout_height="310dp"
    android:layout_gravity="center" android:orientation="vertical" android:padding="16dp"
    android:elevation="0dp" android:stateListAnimator="@null">
    <TextView android:id="@+id/pf_scene_seat" android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:layout_marginBottom="4dp" android:textSize="12sp" android:textColor="#FF9E9E9E"
        android:fontFamily="@font/jetbrainsmono_medium" />
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginBottom="16dp" android:orientation="horizontal" android:gravity="center_vertical">
        <TextView android:id="@+id/pf_scene_title" android:layout_width="0dp" android:layout_height="wrap_content"
            android:layout_weight="1" android:textSize="16sp" android:textColor="#FFFFFFFF"
            android:text="@string/pf_scene_picker_hint" />
        <ImageView android:id="@+id/pf_scene_edit" android:layout_width="24dp" android:layout_height="24dp"
            android:background="?selectableItemBackgroundBorderless" android:focusable="true" android:clickable="true"
            android:src="@drawable/pf_scene_ic_edit_card" app:tint="#FF8E8E93" />
    </LinearLayout>
    <ScrollView android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1"
        android:scrollbars="vertical" android:fadeScrollbars="false">
        <com.google.android.flexbox.FlexboxLayout android:id="@+id/pf_scene_tags"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            app:alignContent="flex_start" app:alignItems="flex_start" app:flexWrap="wrap" app:justifyContent="flex_start" />
    </ScrollView>
</LinearLayout>
