<?xml version="1.0" encoding="utf-8"?>




<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="@dimen/radius_pill" />
            <gradient
                android:angle="270"
                android:startColor="@color/glass_stroke_top"
                android:endColor="@color/glass_stroke_bottom" />
        </shape>
    </item>
    <item
        android:bottom="@dimen/stroke_hairline"
        android:left="@dimen/stroke_hairline"
        android:right="@dimen/stroke_hairline"
        android:top="@dimen/stroke_hairline">
        <shape android:shape="rectangle">
            <corners android:radius="@dimen/radius_pill" />
            <solid android:color="@color/surface_glass" />
        </shape>
    </item>
</layer-list>
