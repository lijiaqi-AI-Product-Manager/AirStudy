<?xml version="1.0" encoding="utf-8"?>
<!-- Three floating steps share the source panel. Source compact/expanded panels
     own their route, clock, scene, distance and seat controls. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_base">

    <com.projectfocus.feature.booking.plan.TakeoffPlanView
        android:id="@+id/takeoffPlan"
        android:layout_width="300dp"
        android:layout_height="wrap_content"
        android:layout_gravity="top|center_horizontal"
        android:layout_marginTop="60dp" />

    <LinearLayout
        android:layout_width="300dp"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|center_horizontal"
        android:layout_marginBottom="40dp"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tvPreparationStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            android:accessibilityLiveRegion="polite"
            android:fontFamily="@font/harmonyos_sans_sc_medium"
            android:gravity="center"
            android:textColor="@color/text_secondary"
            android:textSize="12sp"
            android:visibility="gone" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnPreparationStart"
            android:layout_width="300dp"
            android:layout_height="56dp"
            android:fontFamily="@font/harmonyos_sans_sc_medium"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:enabled="false"
            android:stateListAnimator="@null"
            android:text="@string/flight_preparation_start"
            android:textAllCaps="false"
            android:textColor="@android:color/white"
            android:textSize="16sp"
            app:backgroundTint="@android:color/black"
            app:cornerRadius="28dp"
            app:elevation="0dp" />
    </LinearLayout>
</FrameLayout>
