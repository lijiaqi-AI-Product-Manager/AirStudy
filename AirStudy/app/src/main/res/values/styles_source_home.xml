<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="PfSourceHomeMenu">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginEnd">16dp</item>
        <item name="android:layout_gravity">center_vertical</item>
        <item name="android:fontFamily">@font/harmonyos_sans_sc_medium</item>
        <item name="android:textSize">16sp</item>
        <item name="android:textColor">@color/source_home_menu_text</item>
        <item name="android:focusable">true</item>
        <item name="android:clickable">true</item>
        <item name="android:background">?android:attr/selectableItemBackgroundBorderless</item>
    </style>
    <style name="PfSourceHomeMenu.Takeoff">
        <item name="android:textSize">18sp</item>
        <item name="android:textStyle">bold</item>
    </style>
    <!-- Geometry is original; option rendering is an adapter while the protected
         MapStyleSelectorView implementation remains unavailable. -->
    <style name="PfSourceMapStyleOption">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">0dp</item>
        <item name="android:layout_columnWeight">1</item>
        <item name="android:layout_rowWeight">1</item>
        <item name="android:gravity">center</item>
        <item name="android:fontFamily">@font/harmonyos_sans_sc_medium</item>
        <item name="android:textSize">14sp</item>
        <item name="android:textColor">@android:color/black</item>
        <item name="android:background">@drawable/bg_source_map_style_option</item>
        <item name="android:clickable">true</item>
        <item name="android:focusable">true</item>
    </style>
</resources>
