<?xml version="1.0" encoding="utf-8"?>

<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:fitsSystemWindows="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center_horizontal"
        android:paddingHorizontal="@dimen/screen_margin"
        android:paddingTop="@dimen/space_xxl"
        android:paddingBottom="@dimen/space_xxl">

        <!-- 顶部一个小飞机图标，暗示「航线被挡住」 -->
        <ImageView
            android:layout_width="72dp"
            android:layout_height="72dp"
            android:src="@drawable/ic_focus_notification"
            app:tint="@color/focus_blocked_icon_tint"
            android:contentDescription="@null" />

        <TextView
            android:id="@+id/tv_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_l"
            android:text="@string/focus_blocked_title"
            android:textColor="@color/focus_blocked_title"
            android:textSize="26sp"
            android:textStyle="bold"
            android:gravity="center" />

        <TextView
            android:id="@+id/tv_body"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_m"
            android:textColor="@color/focus_blocked_body"
            android:textSize="16sp"
            android:lineSpacingExtra="4dp"
            android:gravity="center"
            tools:text="你正在打开 抖音" />

        <TextView
            android:id="@+id/tv_elapsed"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_l"
            android:textColor="@color/focus_blocked_hint"
            android:textSize="14sp"
            android:fontFeatureSettings="tnum"
            tools:text="已停留 12 秒" />

        <Space
            android:layout_width="1dp"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_xxl"
            android:text="@string/focus_blocked_hint"
            android:textColor="@color/focus_blocked_hint"
            android:textSize="13sp"
            android:gravity="center" />

        <Button
            android:id="@+id/btn_back"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="@dimen/space_m"
            android:text="@string/focus_blocked_back"
            android:textSize="17sp"
            android:textColor="@color/focus_blocked_action_text"
            android:background="@color/focus_blocked_action_bg" />

        <TextView
            android:id="@+id/btn_give_up"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="@dimen/space_s"
            android:text="@string/focus_blocked_give_up"
            android:textColor="@color/focus_blocked_hint"
            android:textSize="14sp"
            android:gravity="center"
            android:visibility="gone"
            tools:visibility="visible" />

    </LinearLayout>
</ScrollView>
