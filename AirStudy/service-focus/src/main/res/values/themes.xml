<?xml version="1.0" encoding="utf-8"?>

<resources xmlns:tools="http://schemas.android.com/tools">

    <style name="Theme.Pf.Blocked" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="android:windowBackground">@color/focus_blocked_bg</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">@bool/focus_blocked_light_system_bars</item>
        <item name="android:windowAnimationStyle">@style/Animation.Pf.Blocked</item>
        <item name="android:windowLayoutInDisplayCutoutMode" tools:targetApi="p">shortEdges</item>
    </style>

    <style name="Animation.Pf.Blocked" parent="@android:style/Animation.Activity">
        <item name="android:activityOpenEnterAnimation">@anim/pf_blocked_in</item>
        <item name="android:activityOpenExitAnimation">@android:anim/fade_out</item>
        <item name="android:activityCloseExitAnimation">@android:anim/fade_out</item>
        <item name="android:activityCloseEnterAnimation">@android:anim/fade_in</item>
    </style>

</resources>
