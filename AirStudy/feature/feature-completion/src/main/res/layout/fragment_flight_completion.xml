<?xml version="1.0" encoding="utf-8"?>
<!-- Arrival overlay; visibility is controlled by its host. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/flight_completion_overlay"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/arrival_ambient_background"
    android:visibility="gone">

    <ImageView
        android:id="@+id/arrival_background_image"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:alpha="0"
        android:scaleType="centerCrop" />

    <ImageView
        android:id="@+id/arrival_background_image_next"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:alpha="0"
        android:scaleType="centerCrop" />

    <View
        android:id="@+id/gradient_overlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/arrival_ambient_overlay_fallback" />

    <ScrollView
        android:id="@+id/arrival_completion_scroll"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:paddingStart="28dp"
        android:paddingTop="32dp"
        android:paddingEnd="28dp"
        android:paddingBottom="106dp"
        android:clipToPadding="false"
        android:fillViewport="true"
        android:overScrollMode="never">

        <LinearLayout
            android:id="@+id/arrival_completion_content"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:orientation="vertical">

            <com.projectfocus.feature.completion.arrival.ArrivalSquareFrameLayout
                android:id="@+id/arrival_media_frame"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_arrival_image_placeholder">

                <FrameLayout
                    android:id="@+id/arrival_media_pager"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent" />

                <LinearLayout
                    android:id="@+id/arrival_media_indicator"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center|top"
                    android:layout_marginTop="18dp"
                    android:gravity="center"
                    android:orientation="horizontal" />

                <View
                    android:id="@+id/arrival_media_scrim"
                    android:layout_width="match_parent"
                    android:layout_height="112dp"
                    android:layout_gravity="bottom"
                    android:background="@drawable/gradient_arrival_media_scrim" />

                <TextView
                    android:id="@+id/arrival_airport_code_on_media"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="start|bottom|center"
                    android:layout_marginStart="20dp"
                    android:layout_marginBottom="18dp"
                    android:fontFamily="@font/source_han_serif_cn_semibold"
                    android:includeFontPadding="false"
                    android:shadowColor="#66000000"
                    android:shadowDx="0"
                    android:shadowDy="2"
                    android:shadowRadius="8"
                    android:textColor="@android:color/white"
                    android:textSize="36sp" />

            </com.projectfocus.feature.completion.arrival.ArrivalSquareFrameLayout>

            <TextView
                android:id="@+id/welcome_text"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="30dp"
                android:fontFamily="@font/source_han_serif_cn_light"
                android:includeFontPadding="false"
                android:text="@string/arrival_welcome"
                android:textColor="#CCFFFFFF"
                android:textSize="22sp" />

            <TextView
                android:id="@+id/arrival_city_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:ellipsize="end"
                android:fontFamily="@font/source_han_serif_cn_regular"
                android:includeFontPadding="false"
                android:letterSpacing="0"
                android:maxLines="2"
                android:shadowColor="#33000000"
                android:shadowDx="0"
                android:shadowDy="3"
                android:shadowRadius="12"
                android:textColor="@android:color/white"
                android:textSize="46sp" />

            <TextView
                android:id="@+id/arrival_airport_link"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:fontFamily="@font/source_han_serif_cn_regular"
                android:includeFontPadding="false"
                android:textColor="#F2FFFFFF"
                android:textSize="18sp" />

            <TextView
                android:id="@+id/welcome_subtitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:fontFamily="@font/source_han_serif_cn_light"
                android:textColor="#99FFFFFF"
                android:textSize="13sp" />

            <LinearLayout
                android:id="@+id/stats_container"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="22dp"
                android:gravity="center"
                android:orientation="horizontal"
                android:visibility="gone">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:paddingEnd="18dp">

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:baselineAligned="true"
                        android:gravity="center"
                        android:orientation="horizontal">

                        <TextView
                            android:id="@+id/tv_mileage_plus_ghost"
                            android:layout_width="0dp"
                            android:layout_height="0dp"
                            android:visibility="gone" />

                        <com.projectfocus.core.ui.widget.RollingNumberView
                            android:id="@+id/nsv_mileage"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content" />

                        <TextView
                            android:id="@+id/tv_mileage_unit"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="6dp"
                            android:fontFamily="@font/source_han_serif_cn_light"
                            android:includeFontPadding="false"
                            android:text="@string/common_km"
                            android:textColor="#CCFFFFFF"
                            android:textSize="12sp" />

                        <TextView
                            android:id="@+id/tv_mileage_plus"
                            android:layout_width="0dp"
                            android:layout_height="0dp"
                            android:visibility="gone" />

                    </LinearLayout>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:fontFamily="@font/source_han_serif_cn_regular"
                        android:includeFontPadding="false"
                        android:text="@string/arrival_today_mileage"
                        android:textColor="#E6FFFFFF"
                        android:textSize="15sp" />

                </LinearLayout>

                <View
                    android:layout_width="1dp"
                    android:layout_height="30dp"
                    android:background="#66FFFFFF" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:paddingStart="18dp">

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:baselineAligned="true"
                        android:gravity="center"
                        android:orientation="horizontal">

                        <TextView
                            android:id="@+id/tv_focus_plus_ghost"
                            android:layout_width="0dp"
                            android:layout_height="0dp"
                            android:visibility="gone" />

                        <com.projectfocus.core.ui.widget.RollingNumberView
                            android:id="@+id/nsv_focus"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content" />

                        <TextView
                            android:id="@+id/tv_focus_unit"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="6dp"
                            android:fontFamily="@font/source_han_serif_cn_light"
                            android:includeFontPadding="false"
                            android:text="@string/common_min"
                            android:textColor="#CCFFFFFF"
                            android:textSize="12sp" />

                        <TextView
                            android:id="@+id/tv_focus_plus"
                            android:layout_width="0dp"
                            android:layout_height="0dp"
                            android:visibility="gone" />

                    </LinearLayout>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:fontFamily="@font/source_han_serif_cn_regular"
                        android:includeFontPadding="false"
                        android:text="@string/arrival_today_duration"
                        android:textColor="#E6FFFFFF"
                        android:textSize="15sp" />

                </LinearLayout>

            </LinearLayout>

        </LinearLayout>

    </ScrollView>

    <View
        android:id="@+id/arrival_completion_bottom_scrim"
        android:layout_width="match_parent"
        android:layout_height="140dp"
        android:layout_gravity="bottom"
        android:background="@drawable/gradient_arrival_bottom_actions_scrim" />

    <LinearLayout
        android:id="@+id/flight_completion_actions"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:gravity="center"
        android:orientation="horizontal"
        android:paddingStart="28dp"
        android:paddingEnd="28dp"
        android:paddingBottom="30dp">

        <ImageButton
            android:id="@+id/restart_flight_button"
            android:layout_width="52dp"
            android:layout_height="52dp"
            android:background="@drawable/bg_arrival_icon_button"
            android:contentDescription="@string/arrival_share_flight"
            android:padding="14dp"
            android:scaleType="centerInside"
            android:src="@drawable/ic_share"
            app:tint="@android:color/white" />

        <ImageButton
            android:id="@+id/report_airport_button"
            android:layout_width="52dp"
            android:layout_height="52dp"
            android:layout_marginStart="12dp"
            android:background="@drawable/bg_arrival_icon_button"
            android:contentDescription="@string/arrival_report_airport"
            android:padding="14dp"
            android:scaleType="centerInside"
            android:src="@drawable/ic_toast_warning"
            app:tint="@android:color/white" />

        <TextView
            android:id="@+id/complete_flight_button"
            android:layout_width="0dp"
            android:layout_height="52dp"
            android:layout_marginStart="18dp"
            android:layout_weight="1"
            android:background="@drawable/bg_arrival_primary_button"
            android:clickable="true"
            android:focusable="true"
            android:fontFamily="@font/source_han_serif_cn_regular"
            android:gravity="center"
            android:text="@string/flight_completion_complete_button"
            android:textColor="#FF111111"
            android:textSize="18sp" />

    </LinearLayout>

</FrameLayout>
