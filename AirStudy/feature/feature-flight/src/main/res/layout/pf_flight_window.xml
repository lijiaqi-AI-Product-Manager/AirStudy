<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent" android:layout_height="match_parent" android:background="@color/pf_flight_window_surface">
    <com.projectfocus.feature.flight.window.FlightSceneLayout
        android:layout_width="240dp" android:layout_height="360dp" android:layout_gravity="center">
    <androidx.media3.ui.PlayerView android:id="@+id/pf_flight_player"
        android:layout_width="match_parent" android:layout_height="match_parent"
        app:resize_mode="fill" app:surface_type="texture_view" app:use_controller="false"
        app:shutter_background_color="@android:color/transparent" />
    <androidx.media3.ui.PlayerView android:id="@+id/pf_flight_player_overlay"
        android:layout_width="match_parent" android:layout_height="match_parent"
        android:alpha="0" app:resize_mode="fill" app:surface_type="texture_view" app:use_controller="false" />
    <ImageView android:id="@+id/pf_flight_scene_poster" android:layout_width="match_parent" android:layout_height="match_parent"
        android:scaleType="fitXY" android:contentDescription="@null" />
    </com.projectfocus.feature.flight.window.FlightSceneLayout>
    <FrameLayout android:id="@+id/pf_flight_satellite_map_container" android:layout_width="240dp"
        android:layout_height="360dp" android:layout_gravity="center" android:visibility="gone" />
    <ImageView android:id="@+id/pf_flight_window_mask" android:layout_width="270dp" android:layout_height="390dp"
        android:layout_gravity="center" android:scaleType="fitXY" android:contentDescription="@null" />
    <View android:id="@+id/pf_flight_window_feather" android:layout_width="270dp" android:layout_height="390dp"
        android:layout_gravity="center" />
</FrameLayout>
