<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto">
    <com.projectfocus.core.ui.sky.SkyBackdropView android:id="@+id/pf_flight_focus_backdrop"
        android:layout_width="match_parent" android:layout_height="match_parent" android:visibility="gone" />
    <LinearLayout android:id="@+id/pf_flight_left_controls" android:layout_width="wrap_content" android:layout_height="48dp"
        android:layout_alignParentStart="true" android:layout_alignParentTop="true" android:layout_marginStart="20dp"
        android:layout_marginTop="20dp" android:orientation="horizontal" android:elevation="20dp">
        <ImageView android:id="@+id/pf_flight_pause" android:layout_width="48dp" android:layout_height="48dp"
            android:padding="12dp" android:src="@drawable/pf_flight_ic_pause"
            android:background="?attr/selectableItemBackgroundBorderless" android:clickable="true" android:focusable="true" />
        <ImageView android:id="@+id/pf_flight_land" android:layout_width="48dp" android:layout_height="48dp"
            android:padding="12dp" android:src="@drawable/pf_flight_ic_land"
            android:visibility="gone" android:background="?attr/selectableItemBackgroundBorderless" android:clickable="true" android:focusable="true" />
        <ImageView android:id="@+id/pf_flight_audio" android:layout_width="48dp" android:layout_height="48dp"
            android:padding="12dp" android:src="@drawable/pf_flight_ic_volume_speaker"
            android:background="?attr/selectableItemBackgroundBorderless" android:clickable="true" android:focusable="true"
            android:contentDescription="@string/pf_flight_audio" />
    </LinearLayout>
    <LinearLayout android:id="@+id/pf_flight_right_controls" android:layout_width="wrap_content" android:layout_height="48dp"
        android:layout_alignParentEnd="true" android:layout_alignParentTop="true" android:layout_marginEnd="20dp"
        android:layout_marginTop="20dp" android:orientation="horizontal" android:elevation="20dp">
        <ImageView android:id="@+id/pf_flight_map_style" android:layout_width="48dp" android:layout_height="48dp"
            android:padding="12dp" android:src="@drawable/pf_flight_ic_map_style" android:background="?attr/selectableItemBackgroundBorderless"
            android:clickable="true" android:focusable="true" android:contentDescription="@string/pf_flight_map_style" />
        <ImageView android:id="@+id/pf_flight_window_toggle" android:layout_width="48dp" android:layout_height="48dp"
            android:padding="12dp" android:src="@drawable/pf_flight_ic_porthole_window" android:background="?attr/selectableItemBackgroundBorderless"
            android:clickable="true" android:focusable="true" />
    </LinearLayout>
    <TextView android:id="@+id/pf_flight_cancel" android:layout_width="140dp" android:layout_height="48dp"
        android:layout_alignParentEnd="true" android:layout_alignParentTop="true" android:layout_marginEnd="20dp"
        android:layout_marginTop="20dp" android:background="@drawable/pf_flight_cancel_button_background"
        android:gravity="center" android:text="@string/pf_flight_hold_cancel" android:textSize="12sp" android:textStyle="bold"
        android:textColor="@color/sky_ink" android:clickable="true" android:longClickable="true"
        android:focusable="true" android:visibility="gone" android:elevation="21dp" />
    <androidx.core.widget.NestedScrollView android:id="@+id/pf_flight_focus_scroll"
        android:layout_width="match_parent" android:layout_height="match_parent"
        android:layout_below="@id/pf_flight_left_controls" android:layout_alignParentBottom="true"
        android:layout_marginTop="20dp" android:layout_marginBottom="180dp"
        android:fillViewport="true" android:clipToPadding="false" android:scrollbars="none" android:visibility="gone">
        <LinearLayout android:id="@+id/pf_flight_focus_content" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:paddingStart="20dp" android:paddingEnd="20dp" android:paddingTop="12dp" android:paddingBottom="12dp"
            android:orientation="vertical" android:gravity="center">
            <TextView android:id="@+id/pf_flight_focus_status" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:textColor="@color/sky_ink_secondary" android:textSize="13sp" android:gravity="center"
                android:fontFamily="@font/pf_apk2_harmonyos_sans_sc_medium" android:layout_marginBottom="16dp" />
            <FrameLayout android:id="@+id/pf_flight_focus_dial_frame" android:layout_width="240dp" android:layout_height="240dp">
                <com.projectfocus.feature.flight.hud.SkyFocusDialView android:id="@+id/pf_flight_focus_dial"
                    android:layout_width="match_parent" android:layout_height="match_parent" />
                <LinearLayout android:id="@+id/pf_flight_focus_clock_content" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_gravity="center"
                    android:paddingStart="28dp" android:paddingEnd="28dp" android:orientation="vertical" android:gravity="center">
                    <TextView android:id="@+id/pf_flight_focus_label" android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:gravity="center" android:textSize="12sp" android:textColor="@color/sky_ink_secondary"
                        android:fontFamily="@font/pf_apk2_harmonyos_sans_sc_medium" />
                    <TextView android:id="@+id/pf_flight_focus_clock" android:layout_width="match_parent" android:layout_height="60dp"
                        android:gravity="center" android:maxLines="1" android:includeFontPadding="false"
                        android:autoSizeTextType="uniform" android:autoSizeMinTextSize="16sp" android:autoSizeMaxTextSize="38sp"
                        android:autoSizeStepGranularity="1sp" android:textColor="@color/sky_ink"
                        android:fontFamily="@font/pf_apk2_jetbrainsmono_medium" />
                </LinearLayout>
            </FrameLayout>
            <TextView android:id="@+id/pf_flight_focus_route" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:gravity="center" android:layout_marginTop="14dp" android:layout_marginBottom="16dp"
                android:textColor="@color/sky_ink" android:textSize="18sp" android:fontFamily="@font/pf_apk2_harmonyos_sans_sc_medium" />
            <TextView android:id="@+id/pf_flight_focus_map_status" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:gravity="center" android:lineSpacingExtra="2dp" android:textColor="@color/sky_ink_secondary" android:textSize="12sp"
                android:fontFamily="@font/pf_apk2_harmonyos_sans_sc_medium" />
            <androidx.appcompat.widget.AppCompatButton android:id="@+id/pf_flight_focus_retry"
                android:layout_width="wrap_content" android:layout_height="wrap_content" android:minHeight="48dp" android:minWidth="112dp"
                android:background="@android:color/transparent" android:textColor="@color/sky_primary" android:textSize="13sp"
                android:text="@string/sky_focus_map_retry" android:layout_marginTop="4dp" android:textAllCaps="false" />
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
    <RelativeLayout android:id="@+id/pf_flight_stats" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_alignParentBottom="true" android:layout_marginBottom="40dp" android:layout_marginStart="24dp"
        android:layout_marginEnd="24dp">
        <androidx.constraintlayout.widget.ConstraintLayout android:id="@+id/pf_flight_distance_container"
            android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:layout_alignParentStart="true" android:layout_alignParentBottom="true"
            android:background="@drawable/pf_flight_flight_info_background">
            <View android:id="@+id/pf_flight_distance_liquid_glass" android:layout_width="0dp" android:layout_height="0dp"
                android:visibility="gone" app:layout_constraintStart_toStartOf="parent" app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent" app:layout_constraintBottom_toBottomOf="parent" />
            <LinearLayout android:id="@+id/pf_flight_distance_content" android:layout_width="wrap_content"
                android:layout_height="wrap_content" android:orientation="vertical" android:padding="12dp"
                app:layout_constraintStart_toStartOf="parent" app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent" app:layout_constraintBottom_toBottomOf="parent">
                <com.projectfocus.feature.flight.hud.SourceNumberScrollView android:id="@+id/pf_flight_distance_value"
                    android:layout_width="wrap_content" android:layout_height="wrap_content" />
                <TextView android:id="@+id/pf_flight_distance_unit" android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="km" android:textSize="12sp" android:textColor="@android:color/black"
                    android:fontFamily="@font/pf_apk2_jetbrainsmono_medium" />
                <TextView android:id="@+id/pf_flight_distance_label" android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="@string/pf_hud_source_distance_remaining" android:textSize="12sp" android:textColor="@android:color/black"
                    android:fontFamily="@font/pf_apk2_harmonyos_sans_sc_medium" />
            </LinearLayout>
        </androidx.constraintlayout.widget.ConstraintLayout>
        <androidx.constraintlayout.widget.ConstraintLayout android:id="@+id/pf_flight_time_container"
            android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:layout_alignParentEnd="true" android:layout_alignParentBottom="true"
            android:background="@drawable/pf_flight_flight_info_background">
            <View android:id="@+id/pf_flight_time_liquid_glass" android:layout_width="0dp" android:layout_height="0dp"
                android:visibility="gone" app:layout_constraintStart_toStartOf="parent" app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent" app:layout_constraintBottom_toBottomOf="parent" />
            <LinearLayout android:id="@+id/pf_flight_time_content" android:layout_width="wrap_content"
                android:layout_height="wrap_content" android:orientation="vertical" android:padding="12dp"
                app:layout_constraintStart_toStartOf="parent" app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent" app:layout_constraintBottom_toBottomOf="parent">
                <com.projectfocus.feature.flight.hud.SourceNumberScrollView android:id="@+id/pf_flight_time_value"
                    android:layout_width="wrap_content" android:layout_height="wrap_content" />
                <TextView android:id="@+id/pf_flight_time_unit" android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="min" android:textSize="12sp" android:textColor="@android:color/black"
                    android:fontFamily="@font/pf_apk2_jetbrainsmono_medium" />
                <TextView android:id="@+id/pf_flight_time_label" android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="@string/pf_hud_source_time_remaining" android:textSize="12sp" android:textColor="@android:color/black"
                    android:fontFamily="@font/pf_apk2_harmonyos_sans_sc_medium" />
            </LinearLayout>
        </androidx.constraintlayout.widget.ConstraintLayout>
    </RelativeLayout>
    <RelativeLayout android:id="@+id/pf_flight_pause_overlay" android:layout_width="match_parent" android:layout_height="match_parent"
        android:background="@drawable/pf_flight_pause_overlay_gradient" android:visibility="gone">
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_alignParentBottom="true"
            android:layout_centerHorizontal="true" android:layout_marginBottom="80dp" android:text="@string/pf_flight_paused"
            android:textSize="16sp" android:textStyle="bold" android:textColor="@android:color/white" android:fontFamily="@font/pf_apk2_harmonyos_sans" />
    </RelativeLayout>
    <LinearLayout android:id="@+id/pf_flight_volume_panel" android:layout_width="240dp" android:layout_height="wrap_content"
        android:layout_marginTop="80dp" android:layout_marginStart="24dp" android:padding="12dp"
        android:background="@drawable/pf_flight_flight_info_background" android:orientation="vertical"
        android:visibility="gone" android:elevation="22dp">
        <TextView android:id="@+id/pf_flight_ambient" android:layout_width="match_parent" android:layout_height="48dp"
            android:gravity="center_vertical" android:textSize="14sp" android:textColor="@color/text_primary" android:clickable="true" android:focusable="true" />
        <TextView android:id="@+id/pf_flight_volume_label" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:textSize="12sp" android:textColor="@color/text_primary" />
        <SeekBar android:id="@+id/pf_flight_volume" android:layout_width="match_parent" android:layout_height="48dp" android:max="100" />
    </LinearLayout>
</merge>
