<?xml version="1.0" encoding="utf-8"?>

























<androidx.core.widget.NestedScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/permissionScroll"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:scrollbars="none">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="@dimen/screen_margin"
        android:paddingTop="@dimen/space_xxl"
        android:paddingEnd="@dimen/screen_margin"
        android:paddingBottom="@dimen/space_xl">

        <!-- ==================== 标题区 ==================== -->
        <TextView
            android:id="@+id/titleText"
            style="@style/Widget.Pf.Text.Display"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/permission_title"
            tools:text="起飞前检查" />

        <TextView
            android:id="@+id/subtitleText"
            style="@style/Widget.Pf.Text.BodyL"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_s"
            android:text="@string/permission_subtitle"
            android:textColor="@color/text_secondary"
            tools:text="需要 3 项系统权限才能真正拦住分心的 App" />

        <!-- ==================== 进度：3/3 ==================== -->
        
        <TextView
            android:id="@+id/progressText"
            style="@style/Widget.Pf.Text.NumericL"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_l"
            android:contentDescription="@string/permission_progress_desc"
            android:textColor="@color/accent_text"
            tools:text="1 / 3 已开启" />

        <!-- ==================== 步骤 1：使用情况访问 ==================== -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardUsageStats"
            style="@style/Widget.Pf.Card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_l">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/stepUsageStats"
                        style="@style/Widget.Pf.Text.NumericM"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:minWidth="@dimen/space_xl"
                        android:textColor="@color/accent_text"
                        tools:text="1" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:layout_marginStart="@dimen/space_s">

                        <TextView
                            style="@style/Widget.Pf.Text.TitleM"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/permission_usage_title" />

                        <TextView
                            style="@style/Widget.Pf.Text.BodyM"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/space_xxs"
                            android:text="@string/permission_usage_desc"
                            android:textColor="@color/text_secondary" />
                    </LinearLayout>
                </LinearLayout>

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnUsageStats"
                    style="@style/Widget.Pf.Button.Primary"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_m"
                    android:text="@string/permission_action_enable" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- ==================== 步骤 2：悬浮窗 ==================== -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardOverlay"
            style="@style/Widget.Pf.Card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_m">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/stepOverlay"
                        style="@style/Widget.Pf.Text.NumericM"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:minWidth="@dimen/space_xl"
                        android:textColor="@color/accent_text"
                        tools:text="2" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:layout_marginStart="@dimen/space_s">

                        <TextView
                            style="@style/Widget.Pf.Text.TitleM"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/permission_overlay_title" />

                        <TextView
                            style="@style/Widget.Pf.Text.BodyM"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/space_xxs"
                            android:text="@string/permission_overlay_desc"
                            android:textColor="@color/text_secondary" />
                    </LinearLayout>
                </LinearLayout>

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnOverlay"
                    style="@style/Widget.Pf.Button.Primary"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_m"
                    android:text="@string/permission_action_enable" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- ==================== 步骤 3：通知 ==================== -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardNotification"
            style="@style/Widget.Pf.Card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_m">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/stepNotification"
                        style="@style/Widget.Pf.Text.NumericM"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:minWidth="@dimen/space_xl"
                        android:textColor="@color/accent_text"
                        tools:text="3" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:layout_marginStart="@dimen/space_s">

                        <TextView
                            style="@style/Widget.Pf.Text.TitleM"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/permission_notification_title" />

                        <TextView
                            style="@style/Widget.Pf.Text.BodyM"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/space_xxs"
                            android:text="@string/permission_notification_desc"
                            android:textColor="@color/text_secondary" />
                    </LinearLayout>
                </LinearLayout>

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnNotification"
                    style="@style/Widget.Pf.Button.Primary"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_m"
                    android:text="@string/permission_action_enable" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- ==================== 可选：电池优化 ==================== -->
        
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardBattery"
            style="@style/Widget.Pf.Card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_m">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <TextView
                    style="@style/Widget.Pf.Text.TitleM"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/permission_battery_title" />

                <TextView
                    style="@style/Widget.Pf.Text.BodyM"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_xxs"
                    android:text="@string/permission_battery_desc"
                    android:textColor="@color/text_secondary" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnBattery"
                    style="@style/Widget.Pf.Button.Secondary"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_m"
                    android:text="@string/permission_action_enable" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- ==================== 「没找到？」兜底提示 ==================== -->
        
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/hintCard"
            style="@style/Widget.Pf.Card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_m"
            android:visibility="gone"
            tools:visibility="visible">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <TextView
                    style="@style/Widget.Pf.Text.TitleM"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/permission_hint_title"
                    android:textColor="@color/semantic_warning" />

                <TextView
                    style="@style/Widget.Pf.Text.BodyM"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_xxs"
                    android:text="@string/permission_hint_body"
                    android:textColor="@color/text_secondary" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnDismissHint"
                    style="@style/Widget.Pf.Button.Text"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="end"
                    android:text="@string/permission_hint_dismiss" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <Space
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:minHeight="@dimen/space_xl" />

        <!-- ==================== 底部动作 ==================== -->
        
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnPreview"
            style="@style/Widget.Pf.Button.Text"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/permission_action_preview" />

        <TextView
            android:id="@+id/previewWarning"
            style="@style/Widget.Pf.Text.Caption"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_xs"
            android:gravity="center"
            android:text="@string/permission_preview_warning"
            android:textColor="@color/text_tertiary"
            android:visibility="gone"
            tools:visibility="visible" />
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
