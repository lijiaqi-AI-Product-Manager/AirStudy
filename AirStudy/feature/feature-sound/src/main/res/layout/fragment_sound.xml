<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_page_glow"
    android:fitsSystemWindows="true"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="@dimen/touch_target_comfortable"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="@dimen/space_s"
        android:paddingEnd="@dimen/screen_margin">

        <TextView
            android:id="@+id/btnSoundBack"
            android:layout_width="@dimen/touch_target_min"
            android:layout_height="@dimen/touch_target_min"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/sound_back"
            android:gravity="center"
            android:text="‹"
            android:textColor="@color/text_primary"
            android:textSize="30sp" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/space_xs"
            android:layout_weight="1"
            android:text="@string/sound_title"
            android:textAppearance="@style/TextAppearance.Pf.TitleL"
            android:textColor="@color/text_primary" />
    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:paddingBottom="@dimen/space_xxl"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="@dimen/screen_margin"
            android:paddingEnd="@dimen/screen_margin">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingTop="@dimen/space_m"
                android:paddingBottom="@dimen/space_xs">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/sound_enabled"
                        android:textAppearance="@style/TextAppearance.Pf.BodyL"
                        android:textColor="@color/text_primary" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="@string/sound_enabled_hint"
                        android:textAppearance="@style/TextAppearance.Pf.Caption"
                        android:textColor="@color/text_tertiary" />
                </LinearLayout>

                <androidx.appcompat.widget.SwitchCompat
                    android:id="@+id/soundEnabledSwitch"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/space_m" />
            </LinearLayout>

            <TextView
                android:id="@+id/soundVolumeLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_l"
                android:text="@string/sound_volume"
                android:textAppearance="@style/TextAppearance.Pf.BodyM"
                android:textColor="@color/text_secondary" />

            <SeekBar
                android:id="@+id/soundVolumeSeek"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_xs"
                android:max="100"
                android:progress="50" />

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginTop="@dimen/space_m"
                android:layout_marginBottom="@dimen/space_xs"
                android:background="@color/divider" />

            <TextView
                android:id="@+id/soundTrackRain"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:background="?android:attr/selectableItemBackground"
                android:gravity="center_vertical"
                android:text="@string/sound_track_rain"
                android:textAppearance="@style/TextAppearance.Pf.BodyL"
                android:textColor="@color/text_primary" />

            <TextView
                android:id="@+id/soundTrackBonfire"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:background="?android:attr/selectableItemBackground"
                android:gravity="center_vertical"
                android:text="@string/sound_track_bonfire"
                android:textAppearance="@style/TextAppearance.Pf.BodyL"
                android:textColor="@color/text_primary" />

            <TextView
                android:id="@+id/soundTrackForest"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:background="?android:attr/selectableItemBackground"
                android:gravity="center_vertical"
                android:text="@string/sound_track_forest"
                android:textAppearance="@style/TextAppearance.Pf.BodyL"
                android:textColor="@color/text_primary" />

            <TextView
                android:id="@+id/soundTrackOcean"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:background="?android:attr/selectableItemBackground"
                android:gravity="center_vertical"
                android:text="@string/sound_track_ocean"
                android:textAppearance="@style/TextAppearance.Pf.BodyL"
                android:textColor="@color/text_primary" />

            <TextView
                android:id="@+id/soundPlayingLabel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_m"
                android:textAppearance="@style/TextAppearance.Pf.Caption"
                android:textColor="@color/text_tertiary" />

            <TextView
                android:id="@+id/btnSoundStop"
                android:layout_width="match_parent"
                android:layout_height="@dimen/touch_target_comfortable"
                android:layout_marginTop="@dimen/space_s"
                android:background="?android:attr/selectableItemBackground"
                android:gravity="center"
                android:text="@string/sound_stop"
                android:textAppearance="@style/TextAppearance.Pf.BodyM"
                android:textColor="@color/accent_text" />
        </LinearLayout>
    </ScrollView>
</LinearLayout>
