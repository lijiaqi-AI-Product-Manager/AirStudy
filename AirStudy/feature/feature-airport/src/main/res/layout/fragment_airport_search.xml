<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent" android:layout_height="match_parent">
    <com.projectfocus.core.ui.sky.SkyBackdropView android:layout_width="match_parent" android:layout_height="match_parent" />
    <LinearLayout android:id="@+id/airportRoot"
        android:layout_width="match_parent" android:layout_height="match_parent"
        android:orientation="vertical" android:clipChildren="false">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="horizontal" android:gravity="center_vertical"
            android:paddingStart="14dp" android:paddingEnd="22dp" android:paddingTop="12dp" android:paddingBottom="6dp">
            <androidx.appcompat.widget.AppCompatImageButton android:id="@+id/btnBack"
                android:layout_width="48dp" android:layout_height="48dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/airport_search_back"
                android:padding="12dp" android:scaleType="centerInside"
                android:src="@drawable/pf_airport_back" app:tint="@color/sky_ink" />
            <TextView android:id="@+id/airportPageTitle"
                android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
                android:layout_marginStart="6dp" android:fontFamily="@font/harmonyos_sans_sc_bold"
                android:textSize="22sp" android:textColor="@color/sky_ink" android:includeFontPadding="false"
                android:text="@string/sky_airport_explore_title" />
        </LinearLayout>
        <TextView android:id="@+id/airportPageSubtitle"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:paddingStart="22dp" android:paddingEnd="22dp" android:paddingTop="4dp" android:paddingBottom="16dp"
            android:fontFamily="@font/harmonyos_sans_sc_medium" android:textSize="13sp"
            android:textColor="@color/sky_ink_secondary" android:lineSpacingExtra="2dp"
            android:text="@string/sky_airport_explore_intro" />
        <LinearLayout android:id="@+id/searchBar"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="horizontal" android:paddingStart="18dp" android:paddingEnd="18dp"
            android:paddingTop="2dp" android:paddingBottom="16dp" android:clipChildren="false">
            <FrameLayout android:id="@+id/skyAirportSearchField"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:paddingStart="16dp" android:paddingEnd="2dp">
                <EditText android:id="@+id/searchInput"
                    android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="56dp"
                    android:paddingEnd="48dp" android:paddingTop="12dp" android:paddingBottom="12dp"
                    android:background="@null" android:hint="@string/airport_search_hint"
                    android:imeOptions="actionSearch" android:importantForAutofill="no" android:inputType="text"
                    android:maxLines="1" android:singleLine="true" android:textAppearance="@style/TextAppearance.Pf.BodyL"
                    android:textSize="15sp" android:textColor="@color/sky_ink" android:textColorHint="@color/sky_ink_secondary" />
                <androidx.appcompat.widget.AppCompatImageButton android:id="@+id/btnClear"
                    android:layout_width="48dp" android:layout_height="48dp" android:layout_gravity="end|center_vertical"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="@string/airport_search_clear" android:padding="14dp"
                    android:scaleType="centerInside" android:src="@android:drawable/ic_menu_close_clear_cancel"
                    app:tint="@color/sky_ink_secondary" android:visibility="gone" />
            </FrameLayout>
        </LinearLayout>
        <TextView android:id="@+id/resultCount"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:accessibilityLiveRegion="polite" android:paddingStart="22dp" android:paddingEnd="22dp"
            android:paddingTop="2dp" android:paddingBottom="12dp" android:textAppearance="@style/TextAppearance.Pf.Caption"
            android:textColor="@color/sky_ink_secondary" android:visibility="gone" />
        <FrameLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1">
            <androidx.recyclerview.widget.RecyclerView android:id="@+id/resultList"
                android:layout_width="match_parent" android:layout_height="match_parent"
                android:clipToPadding="false" android:paddingStart="18dp" android:paddingEnd="18dp"
                android:paddingBottom="24dp" android:scrollbars="none" />
            <androidx.core.widget.NestedScrollView android:id="@+id/statePanel"
                android:layout_width="match_parent" android:layout_height="match_parent"
                android:fillViewport="true" android:clipToPadding="false" android:scrollbars="none">
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:gravity="center_horizontal" android:orientation="vertical"
                    android:paddingStart="24dp" android:paddingEnd="24dp" android:paddingTop="12dp" android:paddingBottom="32dp">
                    <com.projectfocus.feature.airport.ui.AirportSkyStateView android:id="@+id/stateIllustration"
                        android:layout_width="240dp" android:layout_height="160dp" android:layout_marginBottom="10dp" />
                    <TextView android:id="@+id/stateTitle"
                        android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:gravity="center" android:accessibilityLiveRegion="polite"
                        android:fontFamily="@font/harmonyos_sans_sc_bold"
                        android:textSize="19sp" android:textColor="@color/sky_ink" />
                    <TextView android:id="@+id/stateBody"
                        android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:layout_marginTop="10dp" android:gravity="center" android:lineSpacingExtra="3dp"
                        android:fontFamily="@font/harmonyos_sans_sc_medium" android:textSize="14sp"
                        android:textColor="@color/sky_ink_secondary" />
                    <androidx.appcompat.widget.AppCompatButton android:id="@+id/btnRetry"
                        android:layout_width="wrap_content" android:layout_height="wrap_content" android:minHeight="48dp"
                        android:layout_marginTop="20dp" android:minWidth="132dp"
                        android:paddingStart="24dp" android:paddingEnd="24dp" android:paddingTop="12dp" android:paddingBottom="12dp"
                        android:text="@string/airport_empty_action" android:textAppearance="@style/TextAppearance.Pf.Button"
                        android:textColor="@android:color/white" android:visibility="gone" />
                    <com.projectfocus.feature.airport.ui.IdleRecommendationPanel android:id="@+id/idlePanel"
                        android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:layout_marginTop="12dp" android:visibility="gone" />
                </LinearLayout>
            </androidx.core.widget.NestedScrollView>
        </FrameLayout>
    </LinearLayout>
</FrameLayout>
