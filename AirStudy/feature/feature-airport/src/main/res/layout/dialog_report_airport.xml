<?xml version="1.0" encoding="utf-8"?>







<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingStart="24dp"
    android:paddingTop="8dp"
    android:paddingEnd="24dp"
    android:paddingBottom="4dp">

    <TextView
        android:id="@+id/report_message"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/airport_detail_report_message"
        android:textAppearance="@style/TextAppearance.Pf.BodyM"
        android:textColor="@color/text_secondary" />

    <com.google.android.material.textfield.TextInputLayout
        style="@style/Widget.Pf.TextInputLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:hint="@string/airport_detail_report_hint">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/report_reason_input"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="top|start"
            android:inputType="textMultiLine|textCapSentences"
            android:maxLength="300"
            android:maxLines="6"
            android:minLines="3"
            android:scrollbars="vertical" />
    </com.google.android.material.textfield.TextInputLayout>

    <TextView
        android:id="@+id/report_counter"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:gravity="end"
        android:text="@string/airport_detail_report_counter"
        android:textAppearance="@style/TextAppearance.Pf.Caption"
        android:textColor="@color/text_tertiary" />
</LinearLayout>
