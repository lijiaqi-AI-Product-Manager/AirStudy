<?xml version="1.0" encoding="utf-8"?>
<selector
  xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <set>
            <objectAnimator android:duration="100" android:valueTo="0.7" android:propertyName="alpha" />
        </set>
    </item>
    <item android:state_selected="true">
        <set>
            <objectAnimator android:duration="200" android:valueTo="1.0" android:propertyName="alpha" />
        </set>
    </item>
    <item>
        <set>
            <objectAnimator android:duration="200" android:valueTo="1.0" android:propertyName="alpha" />
        </set>
    </item>
</selector>