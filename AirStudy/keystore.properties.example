# R150：release 签名配置模板。
#
# 用法：复制为同目录下的 keystore.properties（已被 .gitignore 忽略，不会入库），填入真实值。
# 也可以不建文件，改用环境变量（CI 推荐）：
#   PF_RELEASE_STORE_FILE / PF_RELEASE_STORE_PASSWORD / PF_RELEASE_KEY_ALIAS / PF_RELEASE_KEY_PASSWORD
#
# storeFile 可以是绝对路径，也可以是相对 project-focus/ 的路径。
# 证书文件请放在仓库外（*.jks / *.keystore 同样被忽略，但别依赖这一点）。
# 两者都没有时，assembleRelease 照常产出 app-release-unsigned.apk，并打印一条警告。

storeFile=D:/keys/projectfocus-release.jks
storePassword=CHANGE_ME
keyAlias=projectfocus
keyPassword=CHANGE_ME
